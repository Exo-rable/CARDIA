# Leave empty for Docker Compose's same-origin /api proxy.
# For separately hosted services, set the public HTTPS API origin.
VITE_API_URL=

# Optional external frontend origins for direct API access; leave empty when
# using the same-origin Docker Compose proxy.
CARDIA_CORS_ORIGINS=

# Compose binds locally by default. Change the bind address only when the
# service is protected by a trusted HTTPS ingress.
CARDIA_HTTP_BIND_ADDRESS=127.0.0.1
CARDIA_HTTP_PORT=8080
